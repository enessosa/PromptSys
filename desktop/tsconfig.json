{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "out",
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/renderer", "src/**/*.test.ts"]
}
