{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "types": [],
    "rootDir": "src/renderer",
    "outDir": "out/renderer",
    "skipLibCheck": true,
    "moduleDetection": "legacy",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/renderer"]
}
