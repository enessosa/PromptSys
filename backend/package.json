{
  "name": "promptsys-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "@huggingface/transformers": "^4.3.2",
    "hono": "^4.13.18",
    "mammoth": "^1.13.0",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jszip": "^3.10.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
